# Copy this to .env and fill it in.
#
# Testing happens on a SEPARATE bot application. To point a dev machine at the tester
# bot, copy this to local.env as well and put the tester's token (and its own
# DEV_GUILD_ID) there — local.env wins over .env for every name it sets, and anything it
# leaves out falls through to .env, so it only needs the handful of values that differ.
# The deployed host has no local.env and so runs the live bot. Both files are gitignored;
# only this template is committed.

DISCORD_TOKEN=your-bot-token-here

# Optional: set to a test server ID for instant slash-command sync while developing.
# Global sync (leaving this blank) can take up to an hour to propagate on Discord's side.
DEV_GUILD_ID=

# Comma-separated Discord user IDs allowed to use /admin commands (e.g. /admin bypass).
ADMIN_DISCORD_IDS=

SPIDEY_DB_URL=sqlite+aiosqlite:///./spidey.db

# Optional: paste an UptimeRobot Heartbeat monitor's push URL here to enable uptime
# pings. Leave blank to disable — the bot works fine without it. (Requires a paid
# UptimeRobot plan — Heartbeat isn't on the free tier.)
UPTIME_ROBOT_PUSH_URL=

# Port for the /health endpoint (see cogs/health_cog.py), for UptimeRobot's free
# HTTP monitor. Must match the port allocated in your host's Network tab.
SPIDEY_HEALTH_PORT=8080

# Optional: ngrok authtoken + your one free claimed static domain (dashboard.ngrok.com
# after signup). Both must be set for cogs/tunnel_cog.py's tunnel to start — gives the
# bot a permanent HTTPS URL, e.g. for PATREON_REDIRECT_URI below, without owning a
# domain or setting up TLS yourself. Unlike a random quick-tunnel URL, this one never
# changes on restart.
NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=

# Patreon OAuth client (patreon.com/portal/registration/register-clients — make sure
# it's a v2 client, v1 retires Oct 7 2026). PATREON_REDIRECT_URI must exactly match
# one of the redirect URIs registered on that client, including the path — should be
# your NGROK_STATIC_DOMAIN above + /patreon/callback.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=
